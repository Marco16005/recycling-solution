# Copia este archivo como .env y llena los valores. .env no se versiona.
# Contraseñas: solo letras y números (van dentro de URLs de conexión).

# Qué archivos de Compose usa `docker compose` en esta máquina.
#   desarrollo: compose.yaml:compose.dev.yaml
#   producción: compose.yaml:compose.prod.yaml
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Postgres. rs_super solo lo usa el script de inicio que crea los roles.
POSTGRES_PASSWORD=
RS_MIGRADOR_PASSWORD=
RS_APP_PASSWORD=

# Better Auth. Secreto de 32 caracteres o más, p. ej.: openssl rand -hex 32
BETTER_AUTH_SECRET=
# URL con la que se abre la aplicación (en producción, la de Caddy con https).
BETTER_AUTH_URL=http://localhost:3000

# Estilo del mapa. Si se exige operar sin Internet, apuntar a un servidor de teselas local.
MAPA_ESTILO_URL=https://tiles.openfreemap.org/styles/liberty

# Primer administrador (servicio bootstrap). La contraseña se puede borrar de aquí después del primer arranque.
ADMIN_CORREO=
ADMIN_NOMBRE=
ADMIN_CLAVE=

# Producción (docs/operacion.md, §9). Sin dominio propio: DOMINIO=<ip-con-guiones>.sslip.io
# y BETTER_AUTH_URL=https://<ip-con-guiones>.sslip.io
DOMINIO=localhost
# Con Caddy propio: COMPOSE_PROFILES=caddy. Detrás del proxy de otro sistema: déjalo vacío.
COMPOSE_PROFILES=
PUERTO_HTTP=80
PUERTO_HTTPS=443
# Puerto local al que envía el tráfico un proxy existente (solo accesible desde el servidor).
PUERTO_WEB_LOCAL=3001
LIMITE_MEMORIA_WEB=512m
LIMITE_MEMORIA_DB=512m

# Mapa de calles (Plan 7, docs/operacion.md). Activar el perfil mapa (p. ej. COMPOSE_PROFILES=caddy,mapa), preparar el
# mapa una vez con scripts/preparar-mapa.sh y poner OSRM_URL=http://osrm:5000. Vacío = tiempos aproximados (fórmula).
OSRM_URL=
# AAMMDD de un extracto fechado de México en https://download.geofabrik.de/north-america/mexico.html (p. ej. 261015).
MAPA_FECHA=
# Caja del recorte: oeste,sur,este,norte. Por omisión, zona metropolitana de Querétaro y El Marqués.
MAPA_CAJA=-100.65,20.45,-100.05,20.85
LIMITE_MEMORIA_OSRM=256m

# Aviso de privacidad (docs/legal/README.md). Los usa `docker compose run --rm migrate npm run publicar-aviso`.
PUBLICADO_POR=
AVISO_RAZON_SOCIAL=
AVISO_DOMICILIO=
AVISO_NOMBRE_RESPONSABLE_DATOS=
AVISO_CORREO_PRIVACIDAD=
AVISO_TELEFONO_PRIVACIDAD=
AVISO_HORARIO_ATENCION=9:00 a 17:00 h
AVISO_PROVEEDOR_HOSPEDAJE=Hostinger (servidor virtual privado)
AVISO_PROVEEDOR_RESPALDOS=
AVISO_PROVEEDOR_MAPAS=OpenFreeMap
AVISO_URL_AVISO=
AVISO_PLAZO_CLIENTES=
AVISO_PLAZO_ACEPTACIONES=
AVISO_PLAZO_USUARIOS=
AVISO_PLAZO_OPERADORES=
AVISO_PLAZO_BITACORA=
AVISO_PLAZO_RUTAS=
